# MLflow tracking server (use `make dev-up` to bring up the local stack)
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
MLFLOW_EXPERIMENT_NAME=cluster_canary__oom_30min

# MinIO (artifact store + DVC remote)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_S3_ENDPOINT_URL=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Postgres (MLflow backend store)
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow
POSTGRES_DB=mlflow

# BentoML serving (Phase 5)
MODEL_VERSION=0.1.0
MODELS_DIR=models           # where canary_model.txt + calibrator.pkl + feature_list.json live
BENTOML_PORT=3000
SERVE_URL=http://localhost:3000
# Locust knobs:
LT_USERS=200
LT_SPAWN=20
LT_DURATION=5m

# Prefect
PREFECT_API_URL=http://localhost:4200/api

# Phase 1 — Prometheus scraper
PROMETHEUS_URL=http://localhost:9090
SCRAPE_STEP=15s
LEAD_MINUTES=30
COOLDOWN_MINUTES=5
# SCRAPE_START / SCRAPE_END default to (now - 24h, now); set ISO strings to override.

# Phase 2 — Alibaba 2018 trace
ALIBABA_RAW_DIR=data/raw/alibaba
ALIBABA_INTERIM_DIR=data/interim/alibaba
ALIBABA_LABELED_DIR=data/interim/alibaba_labeled
# Comma-separated subset of {machine_meta, container_meta, machine_usage, container_usage, batch_task}.
# Empty = all defaults. Use machine_meta,container_meta,batch_task for a fast (~127 MB) smoke test.
ALIBABA_FILES=
ALIBABA_SKIP_DOWNLOAD=0  # set to 1 if you've already fetched the tarballs out-of-band

# Phase 3 — Feature engineering + temporal split
FEATURES_PROCESSED_DIR=data/processed
FEATURES_REPORTS_DIR=reports/eval
TRAIN_FRAC=0.60
VAL_FRAC=0.20

# Phase 4 — Training (baseline + LightGBM + Optuna + isotonic calibration)
PROCESSED_DIR=data/processed
MODELS_DIR=models
REPORTS_DIR=reports/eval
OPTUNA_N_TRIALS=50          # set to 5-10 for smoke runs (`make train-fast`)
DECISION_THRESHOLD=0.7      # action-router fires above this
TARGET_POSITIVE_RATE=0.10   # negative-downsampling target
DATASET_VERSION=             # set this to the DVC short hash of data/processed/

# Project metadata (used as MLflow author tag)
USER=sharan
