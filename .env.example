# MLflow tracking server (use `make dev-up` to bring up the local stack)
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
MLFLOW_EXPERIMENT_NAME=cluster_canary__oom_30min

# MinIO (artifact store + DVC remote)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_S3_ENDPOINT_URL=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Postgres (MLflow backend store)
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow
POSTGRES_DB=mlflow

# BentoML serving
MODEL_TAG=oom_predictor_lgbm:latest
BENTOML_PORT=3000

# Prefect
PREFECT_API_URL=http://localhost:4200/api

# Phase 1 — Prometheus scraper
PROMETHEUS_URL=http://localhost:9090
SCRAPE_STEP=15s
LEAD_MINUTES=30
COOLDOWN_MINUTES=5
# SCRAPE_START / SCRAPE_END default to (now - 24h, now); set ISO strings to override.

# Project metadata (used as MLflow author tag)
USER=sharan
